# Required bot token
DISCORD_TOKEN=your_discord_bot_token_here

# Guild targeting
# Optional legacy single-guild default:
GUILD_ID=123456789012345678
# Optional multi-guild allowlist (comma-separated guild IDs):
MANAGED_GUILD_IDS=
# Optional global bot action log channel fallback (per-guild settings can override):
# Bot_Log_Channel=123456789012345678

# Web admin listener
# ------------------------------------------------------------------
# RECOMMENDED COURSE OF ACTION:
#   • The Flask web admin GUI is bound to WEB_PORT (default 8080) and
#     WEB_BIND_HOST. The internal health endpoint is served on the
#     same port (Flask's /health route) and is what Docker's
#     HEALTHCHECK probes inside the container.
#   • For a typical setup, keep WEB_BIND_HOST=0.0.0.0 so the admin
#     GUI is reachable from the host network. The matching
#     docker-compose.yml mapping is `8080:8080`.
#   • If you only want the GUI accessible from the Tailnet / reverse
#     proxy, change WEB_BIND_HOST to 127.0.0.1 and the compose mapping
#     to `127.0.0.1:8080:8080`. The container will still respond to
#     HEALTHCHECK on its loopback.
#   • Do NOT expose 8081 from the container — the admin GUI no longer
#     listens there. Historically a second mapping caused confusion
#     when nothing was reachable on host :8081.
# ------------------------------------------------------------------
WEB_ENABLED=true
WEB_BIND_HOST=0.0.0.0
WEB_PORT=8080
WEB_TLS_ENABLED=false
WEB_TLS_PORT=8081
# Optional custom cert/key pair. If both are empty and WEB_TLS_ENABLED=true, adhoc self-signed TLS is used.
WEB_TLS_CERT_FILE=
WEB_TLS_KEY_FILE=

# Discord behavior
ENABLE_MEMBERS_INTENT=false
ENABLE_MESSAGE_CONTENT_INTENT=false
COMMAND_RESPONSES_EPHEMERAL=false

# Random puppy command
PUPPY_IMAGE_API_URL=https://dog.ceo/api/breeds/image/random
PUPPY_IMAGE_TIMEOUT_SECONDS=8

# Fun commands
FUN_API_TIMEOUT_SECONDS=8
CAT_IMAGE_API_URL=https://api.thecatapi.com/v1/images/search
MEME_API_URL=https://meme-api.com/gimme
DAD_JOKE_API_URL=https://icanhazdadjoke.com/

# URL shortener integration
SHORTENER_ENABLED=true
SHORTENER_BASE_URL=https://l.twy4.us
SHORTENER_TIMEOUT_SECONDS=8

# YouTube notifications
YOUTUBE_NOTIFY_ENABLED=true
YOUTUBE_POLL_INTERVAL_SECONDS=300
YOUTUBE_REQUEST_TIMEOUT_SECONDS=12

# Translation
TRANSLATE_API_URL=https://libretranslate.de/translate
TRANSLATE_API_KEY=
TRANSLATE_TIMEOUT_SECONDS=12

# Ollama (disabled until configured)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=30

# Wiki help search
WIKI_SEARCH_ENABLED=true
WIKI_SEARCH_URL=
WIKI_SEARCH_TIMEOUT_SECONDS=12

# WordPress and LinkedIn feed integration timeouts
WORDPRESS_REQUEST_TIMEOUT_SECONDS=12
LINKEDIN_REQUEST_TIMEOUT_SECONDS=12

# Spicy Prompts content repo
SPICY_PROMPTS_ENABLED=true
SPICY_PROMPTS_REPO_URL=https://github.com/wickedyoda/SpicyGameAndBookTokQuiz
SPICY_PROMPTS_REPO_BRANCH=main
SPICY_PROMPTS_MANIFEST_PATH=manifests/index.json
SPICY_PROMPTS_REQUEST_TIMEOUT_SECONDS=12
SPICY_PROMPTS_REFRESH_ON_BOOT=true
SPICY_PROMPTS_REFRESH_INTERVAL_HOURS=24

# Member activity backfill (optional)
# MEMBER_ACTIVITY_BACKFILL_SINCE accepts ISO timestamps or YYYY-MM-DD (UTC). Example: 2026-01-01
MEMBER_ACTIVITY_BACKFILL_ENABLED=false
MEMBER_ACTIVITY_BACKFILL_SINCE=
MEMBER_ACTIVITY_BACKFILL_GUILD_ID=
MEMBER_ACTIVITY_BACKFILL_PROGRESS_LOG_INTERVAL=500

# Uptime status integration
UPTIME_STATUS_ENABLED=true
UPTIME_STATUS_PAGE_URL=https://randy.wickedyoda.com/status/everything
UPTIME_STATUS_TIMEOUT_SECONDS=8

# Uptime Kuma admin (local Docker container)
# Set UPTIME_KUMA_ENABLED=true and provide the instance URL + API key to manage monitors from the web admin.
UPTIME_KUMA_ENABLED=false
UPTIME_KUMA_BASE_URL=http://uptime-kuma:3001
UPTIME_KUMA_API_KEY=
# Set UPTIME_KUMA_ADMIN_ENABLED=true to expose a reverse proxy to the Kuma web UI at /admin/uptime-kuma/proxy/
UPTIME_KUMA_ADMIN_ENABLED=false

# Watchtower → Kuma sync (cron job updates container IDs in Kuma after Watchtower recreates containers)
# SSH target for the host running Uptime Kuma (where the Kuma Docker DB lives)
WATCHTOWER_KUMA_DB_SSH=serv1-docker
# Kuma data directory on the remote host
WATCHTOWER_KUMA_DATA_PATH=/root/docker/uptime-kuma/data
# Docker hosts to check for container recreation (comma-separated SSH targets)
WATCHTOWER_DOCKER_HOSTS_SSH=recipe-host,serv1-docker,serv2-docker
# How far back to check for recreated containers (minutes)
WATCHTOWER_SYNC_LOOKBACK_MINUTES=30

# Web auth/session
WEB_ADMIN_DEFAULT_USERNAME=admin@example.com
WEB_ADMIN_DEFAULT_PASSWORD=ChangeMeNow!WkDb0tPr0d
# Optional alternative to WEB_ADMIN_DEFAULT_PASSWORD:
# WEB_ADMIN_DEFAULT_PASSWORD_HASH=pbkdf2:sha256:600000$...$...
WEB_ADMIN_SESSION_SECRET=replace_this_with_a_random_secret
WEB_SESSION_COOKIE_SECURE=true
WEB_SESSION_COOKIE_SAMESITE=Lax
WEB_SESSION_TIMEOUT_MINUTES=60

# Web hardening and controls
WEB_ENFORCE_CSRF=true
WEB_ENFORCE_SAME_ORIGIN_POSTS=true
WEB_AVATAR_MAX_UPLOAD_BYTES=2097152
WEB_RESTART_ENABLED=false

# ------------------------------------------------------------------
# Password reset (forgot-password flow + admin recovery)
# ------------------------------------------------------------------
# RECOMMENDED COURSE OF ACTION:
#   • Leave WEB_PASSWORD_RESET_ENABLED=true. The "Forgot password?" link
#     on /admin/login will always appear when this is on.
#   • If WEB_SMTP_HOST and WEB_SMTP_FROM_EMAIL are set, the bot will email
#     the reset link to the user.
#   • If SMTP is NOT configured, the link is written to the bot log file
#     and the web audit log instead (the user does not receive it by
#     email). An operator with shell access to the container can read it
#     from the log and deliver it out-of-band. This keeps the in-app
#     recovery flow functional even without email.
#   • If you ever lose access to all admin accounts, the in-container
#     CLI also works:
#         docker exec -it wickedyoda-little-helper python -m bot \
#           --reset-password you@example.com \
#           [--new-password 'YourNew!Pass123'] \
#           [--print-reset-link --web-base-url https://your-host]
#     Use `--create-admin` (instead of --reset-password) to provision
#     a brand new admin account.
# ------------------------------------------------------------------
WEB_PASSWORD_RESET_ENABLED=true
# Public base URL used to build reset links. Example: https://wickedyoda.example.com
WEB_PUBLIC_BASE_URL=
WEB_SMTP_HOST=
WEB_SMTP_PORT=587
WEB_SMTP_USERNAME=
WEB_SMTP_PASSWORD=
WEB_SMTP_FROM_EMAIL=
WEB_SMTP_FROM_NAME=Wicked Yoda Bot Admin
WEB_SMTP_SECURITY=starttls

# Paths/storage
# Host-side storage path used by docker-compose.yml when you run `docker compose --env-file env.env ...`
DATA_DIR=/root/docker/wickedyodabot
# Host-side log path used by docker-compose.yml when you run `docker compose --env-file env.env ...`
LOG_DIR=/root/docker/wickedyodabot/logs
# Inside the container, docker-compose.yml overrides DATA_DIR to /app/data and LOG_DIR to /logs.
# Optional explicit SQLite file path. If unset, the bot uses DATA_DIR/mod_actions.db.
# ACTION_DB_PATH=/app/data/mod_actions.db
# Optional env file path for web settings editor:
WEB_ENV_FILE=/app/env.env
# Host path for persisting web GUI env overrides (docker-compose bind mount):
WEB_ENV_FILE_HOST=/root/docker/wickedyodabot/env.env
# Optional external wiki URL button in web GUI:
WEB_GITHUB_WIKI_URL=

# Logging levels
LOG_LEVEL=INFO
CONTAINER_LOG_LEVEL=WARNING
DISCORD_LOG_LEVEL=WARNING
LOG_RETENTION_DAYS=90

# Container timezone (match host). Example: America/Chicago
TZ=America/Chicago
