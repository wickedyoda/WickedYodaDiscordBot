# Required bot token
DISCORD_TOKEN=your_discord_bot_token_here

# Guild targeting
# Optional legacy single-guild default:
GUILD_ID=123456789012345678
# Optional multi-guild allowlist (comma-separated guild IDs):
MANAGED_GUILD_IDS=123456789012345678,987654321098765432

# Web Admin Interface
WEB_ENABLED=true
WEB_PORT=8080
WEB_ADMIN_DEFAULT_USERNAME=admin@example.com
WEB_ADMIN_DEFAULT_PASSWORD=change_this_strong_password

# SMTP Configuration (for password reset emails)
WEB_SMTP_HOST=smtp.example.com
WEB_SMTP_PORT=587
WEB_SMTP_USERNAME=smtp_username
WEB_SMTP_PASSWORD=smtp_password
WEB_SMTP_FROM_EMAIL=noreply@example.com
WEB_SMTP_FROM_NAME="Wicked Yoda Bot Admin"
WEB_SMTP_SECURITY=starttls

# Public base URL for email links (required for password reset)
WEB_PUBLIC_BASE_URL=https://your-domain.com

# Session security
WEB_SESSION_COOKIE_SECURE=true
WEB_SESSION_COOKIE_SAMESITE=Lax
WEB_SESSION_COOKIE_DOMAIN=

# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_ROTATION_DAYS=90
REMEMBER_LOGIN_DAYS=30
