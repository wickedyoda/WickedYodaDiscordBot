# Flask app for password-protected Watch Tower GUI
# Shows containers, image tags, update availability, and allows updates + cron scheduling
FLASK_APP=app.py
FLASK_ENV=production
# Set a strong password for the web GUI (DO NOT use the default in production)
GUI_PASSWORD=ChangeMeNow123!
# Set a strong Flask secret key (DO NOT use the default in production)
FLASK_SECRET_KEY=dev-secret-change-me
# Docker socket path (host path)
DOCKER_SOCK=unix:///var/run/docker.sock
# Cron schedule for auto-update (default: every 6 hours)
WATCHTOWER_SCHEDULE=0 */6 * * *
